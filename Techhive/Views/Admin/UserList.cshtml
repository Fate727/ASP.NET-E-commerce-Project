@model List<Techhive.Models.UserVcountViewModel>
@using Microsoft.AspNetCore.Identity
@inject UserManager<Users> UserManager

@{
    ViewData["Title"] = "User Views";
    Layout = "~/Views/Shared/_adminlayout.cshtml";
    var pageInfo = Model.FirstOrDefault();
}

<div class="main-content-inner">
    <div class="main-content-wrap">
        <div class="flex items-center flex-wrap justify-between gap20 mb-27">
            <h3>User View Statistics</h3>
            <ul class="breadcrumbs flex items-center flex-wrap justify-start gap10">
                <li>
                    <a asp-controller="Admin" asp-action="Dashboard">
                        <div class="text-tiny">Dashboard</div>
                    </a>
                </li>
                <li><i class="icon-chevron-right"></i></li>
                <li><div class="text-tiny">User Views</div></li>
            </ul>
        </div>

        <div class="wg-box">
            <div class="flex items-center justify-between gap10 flex-wrap">
                <div class="wg-filter flex-grow">
                    <form class="form-search" method="GET" asp-action="UserList" asp-controller="Admin">
                        <fieldset class="name">
                            <input type="text" placeholder="Search by username..." name="search" value="@pageInfo?.SearchQuery" />
                        </fieldset>
                        <div class="button-submit">
                            <button type="submit"><i class="icon-search"></i></button>
                        </div>
                    </form>
                </div>
            </div>
            <div class="table-responsive mt-3">
                <table class="table table-striped table-bordered">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Username</th>
                            <th>Email</th>
                            <th>Total Views</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            int count = 1 + ((pageInfo?.CurrentPage - 1 ?? 0) * 10);
                            foreach (var user in Model)
                            {
                                <tr>
                                    <td>@count</td>
                                    <td>@user.UserName</td>
                                    <td>@user.Email</td>
                                    <td>@user.TotalViews</td>
                                    <td>
                                        @if (user.IsCurrentUser)
                                        {
                                            <span><em>You</em></span>
                                        }
                                        else if (!user.IsAdmin)
                                        {
                                            <form asp-controller="Admin" asp-action="DeleteUserView"
                                                  asp-route-id="@user.UserId" method="post"
                                                  onsubmit="return confirm('Are you sure you want to delete view records for this user?');">
                                                <button type="submit" class="btn btn-danger btn-sm">
                                                    <i class="icon-trash-2"></i> Delete
                                                </button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                                count++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center">No user view data found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>


            <div class="divider"></div>

            <!-- Pagination -->
            @if (pageInfo != null && pageInfo.TotalPages > 1)
            {
                <nav aria-label="User pagination">
                    <ul class="pagination justify-content-center">
                        @if (pageInfo.CurrentPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link"
                                   asp-action="UserList"
                                   asp-route-page="@(pageInfo.CurrentPage - 1)"
                                   asp-route-search="@pageInfo.SearchQuery">
                                    &laquo;
                                </a>
                            </li>
                        }

                        @for (int i = 1; i <= pageInfo.TotalPages; i++)
                        {
                            <li class="page-item @(i == pageInfo.CurrentPage ? "active" : "")">
                                <a class="page-link"
                                   asp-action="UserList"
                                   asp-route-page="@i"
                                   asp-route-search="@pageInfo.SearchQuery">@i</a>
                            </li>
                        }

                        @if (pageInfo.CurrentPage < pageInfo.TotalPages)
                        {
                            <li class="page-item">
                                <a class="page-link"
                                   asp-action="UserList"
                                   asp-route-page="@(pageInfo.CurrentPage + 1)"
                                   asp-route-search="@pageInfo.SearchQuery">
                                    &raquo;
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>
